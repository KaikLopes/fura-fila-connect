# =============================================================================
# FuraFila Connect - Docker Compose Environment Variables
# =============================================================================

# PostgreSQL Configuration
POSTGRES_DB=furafila_connect
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT & Security (CHANGE IN PRODUCTION)
JWT_SECRET=your-super-secret-key-change-in-production-12345

# Node Environment
NODE_ENV=production

# Refresh Token Expiry (in days)
REFRESH_TOKEN_EXPIRY=7

# Email Configuration (Para enviar confirmações e reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seu-email@gmail.com
EMAIL_PASSWORD=sua-senha-app
EMAIL_FROM=noreply@furafila.com

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5500

# =============================================================================
# Instruções de Uso:
# =============================================================================
# 1. Copie este arquivo para .env
#    cp .env.example .env
#
# 2. Edite os valores conforme necessário
#
# 3. Para produção:
#    - MUDE o JWT_SECRET
#    - MUDE a POSTGRES_PASSWORD
#    - Configure credenciais reais de EMAIL
#    - Use NODE_ENV=production
#
# 4. Para rodar com Docker Compose:
#    docker-compose up
#
# =============================================================================
